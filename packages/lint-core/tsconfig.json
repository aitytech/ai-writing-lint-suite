{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "newLine": "LF",
    "outDir": "./dist/",
    "rootDir": "./src",
    "target": "ES2020",
    "sourceMap": true,
    "declaration": true,
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": [".git", "node_modules", "dist"]
}

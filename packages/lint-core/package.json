{
  "name": "@aitytech/ai-writing-lint-core",
  "version": "0.1.0",
  "private": true,
  "description": "Thin wrapper around @aitytech/textlint-rule-preset-ai-writing-en/-vi and the upstream @textlint-ja preset, for use across web, iOS, and macOS apps. Does not fork or duplicate lint logic — imports the tested/published presets directly.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harper": {
      "types": "./dist/harper.d.ts",
      "default": "./dist/harper.js"
    },
    "./vale": {
      "types": "./dist/vale.d.ts",
      "default": "./dist/vale.js"
    },
    "./english-spelling": {
      "types": "./dist/english-spelling.d.ts",
      "default": "./dist/english-spelling.js"
    },
    "./english-style-lite": {
      "types": "./dist/english-style-lite.d.ts",
      "default": "./dist/english-style-lite.js"
    },
    "./english-grammar-lite": {
      "types": "./dist/english-grammar-lite.d.ts",
      "default": "./dist/english-grammar-lite.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/generate-vi-dictionary.mjs && node scripts/generate-en-dictionary.mjs",
    "build": "tsc -p .",
    "postbuild": "node ../../scripts/obfuscate-dist.mjs dist",
    "dev": "tsc -p . --watch"
  },
  "dependencies": {
    "@aitytech/suzume": "github:aitytech/suzume-wasm#3304cb9ad51b21a835a292ab7efc405df15ae00b",
    "@aitytech/textlint-rule-preset-ai-writing-en": "github:aitytech/textlint-rule-preset-ai-writing-en#3ddc7d5a5c0d6dab04d2bfbd05d9f63a3ba7f2fc",
    "@aitytech/textlint-rule-preset-ai-writing-ja": "github:aitytech/textlint-rule-preset-ai-writing-ja#b3e70ea2186257317ce3f64e4ef4fbaff76bc3d8",
    "@aitytech/textlint-rule-preset-ai-writing-vi": "github:aitytech/textlint-rule-preset-ai-writing-vi#a3c25c7a9b56bf17ab9faf125f309b594dfaca6e",
    "@textlint/kernel": "15.8.0",
    "@textlint/textlint-plugin-markdown": "15.8.0",
    "@textlint/textlint-plugin-text": "15.8.0",
    "@vvago/vale": "3.17.1",
    "dictionary-en": "4.0.0",
    "dictionary-vi": "3.0.0",
    "harper.js": "2.7.0",
    "nspell": "2.1.5",
    "retext": "9.0.0",
    "retext-contractions": "6.0.0",
    "retext-english": "5.0.0",
    "retext-indefinite-article": "5.0.0",
    "retext-repeated-words": "5.0.0",
    "write-good": "1.0.8"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/nspell": "2.1.6",
    "@types/write-good": "^1.0.3",
    "typescript": "7.0.2"
  }
}

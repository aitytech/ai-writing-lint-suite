    "@aitytech/textlint-rule-preset-ai-writing-vi": "github:aitytech/textlint-rule-preset-ai-writing-vi#bb0f17b2d6ac3b72e1fe283ab2a5aec5d1ce8632",
    "@aitytech/textlint-rule-preset-ai-writing-ja": "github:aitytech/textlint-rule-preset-ai-writing-ja#8f3937785760f0a46eb7c178a81442d7fc04791b",

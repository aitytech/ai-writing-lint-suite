{
  "name": "@aitytech/ai-writing-lint-core",
  "version": "0.1.0",
  "private": true,
  "description": "Thin wrapper around @aitytech/textlint-rule-preset-ai-writing-en/-vi and the upstream @textlint-ja preset, for use across web, iOS, and macOS apps. Does not fork or duplicate lint logic — imports the tested/published presets directly.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harper": {
      "types": "./dist/harper.d.ts",
      "default": "./dist/harper.js"
    },
    "./vale": {
      "types": "./dist/vale.d.ts",
      "default": "./dist/vale.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/generate-vi-dictionary.mjs",
    "build": "tsc -p .",
    "dev": "tsc -p . --watch"
  },
  "dependencies": {
    "@aitytech/suzume": "github:aitytech/suzume-wasm#3304cb9ad51b21a835a292ab7efc405df15ae00b",
    "@aitytech/textlint-rule-preset-ai-writing-en": "github:aitytech/textlint-rule-preset-ai-writing-en#b1a3c5b6a06c22af6aba604b2139391113188087",
    "@aitytech/textlint-rule-preset-ai-writing-ja": "github:aitytech/textlint-rule-preset-ai-writing-ja#b3e70ea2186257317ce3f64e4ef4fbaff76bc3d8",
    "@aitytech/textlint-rule-preset-ai-writing-vi": "github:aitytech/textlint-rule-preset-ai-writing-vi#a3c25c7a9b56bf17ab9faf125f309b594dfaca6e",
    "@textlint/kernel": "15.8.0",
    "@textlint/textlint-plugin-markdown": "15.8.0",
    "@textlint/textlint-plugin-text": "15.8.0",
    "@vvago/vale": "3.17.1",
    "dictionary-vi": "3.0.0",
    "harper.js": "2.7.0",
    "nspell": "2.1.5"
  },
  "devDependencies": {
    "@types/nspell": "2.1.6",
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}

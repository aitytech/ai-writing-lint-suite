# mcp-server: suzume.wasm copied in from node_modules before each dev/deploy
# (scripts/copy-suzume-wasm.mjs) so Wrangler's wasm module rule can see it -- regenerated,
# never hand-edited.
apps/mcp-server/src/vendor/
packages/mcp-server/src/vendor/

# forks/: standalone GitHub repos (each has its own .git + remote) that this monorepo consumes
# as pinned git dependencies (see packages/*/package.json and pnpm-workspace.yaml allowBuilds),
# kept as local clones here purely so dev work on them lives next to the code that depends on
# them instead of scattered loose across AITYTECH/. Not part of this repo's own git history --
# each is its own repo, committed and pushed independently.
forks/

# _archive/: superseded/dead local work kept around instead of deleted outright.
_archive/

# Added by ggshield
.cache_ggshield
